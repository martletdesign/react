{
  "name": "@martlet/react",
  "version": "1.0.1",
  "description": "Martlet React components",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE.md",
    "PROVENANCE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@martlet/core": "3.0.1"
  },
  "scripts": {
    "build": "npm run build:package && npm run build:gallery",
    "test": "npm run build:package && node --test tests/*.test.mjs",
    "test:browser": "DESIGN_FAMILY=martlet node tests/browser-check.mjs",
    "build:gallery": "npm run styles:sync && vite build --config examples/react-catalog/vite.config.mjs --mode martlet",
    "build:reference": "npm run build:gallery",
    "styles:sync": "node scripts/sync-core-styles.mjs",
    "styles:check": "node scripts/sync-core-styles.mjs --check",
    "build:package": "node build.mjs",
    "preview": "vite preview --config examples/react-catalog/vite.config.mjs --mode martlet",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martletdesign/react.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/react": "19.3.0",
    "esbuild": "0.27.4",
    "markdown-it": "14.3.3",
    "markdown-it-footnote": "4.0.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.158.0"
  }
}
