{
  "name": "@martlet/react",
  "version": "0.2.1",
  "description": "Experimental Martlet React components",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE.md",
    "PROVENANCE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@martlet/core": "github:martletdesign/core#559dd8659b47cf25a0c06cee6c86fd91b541679c"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "DESIGN_FAMILY=martlet node tests/browser-check.mjs",
    "build:gallery": "NIGHTJAR_FAMILY=martlet node examples/react-catalog/build.mjs",
    "build:reference": "node scripts/build-reference-deployment.mjs",
    "styles:sync": "node scripts/sync-core-styles.mjs",
    "styles:check": "node scripts/sync-core-styles.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martletdesign/react.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/react": "19.3.0",
    "esbuild": "0.27.4",
    "markdown-it": "14.3.3",
    "markdown-it-footnote": "4.0.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
